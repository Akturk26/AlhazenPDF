{
  "rewrites": [
    { "source": "/servis/:plaka", "destination": "/servis.html" },
    { "source": "/gizlilik", "destination": "/gizlilik.html" },
    { "source": "/hesap-sil", "destination": "/hesap-sil/index.html" },
    { "source": "/plan", "destination": "/plan.html" },
    { "source": "/basvuru", "destination": "/basvuru.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
